generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Aircraft {
  icao24       String   @id
  callsign     String?
  originCountry String?
  lastSeen     DateTime @default(now())
  observations Observation[]
}
model Observation {
  id        Int      @id @default(autoincrement())
  icao24    String
  latitude  Float
  longitude Float
  altitude  Float?
  velocity  Float?
  heading   Float?
  onGround  Boolean
  observedAt DateTime
  aircraft  Aircraft @relation(fields: [icao24], references: [icao24])
  @@unique([icao24, observedAt])
  @@index([icao24, observedAt])
  @@index([observedAt])
}
model IngestionRun {
  id         Int      @id @default(autoincrement())
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String
  count      Int      @default(0)
  error      String?
  latencyMs  Int?
}
