PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://aerotrack:aerotrack@localhost:5432/aerotrack?schema=public"
REDIS_URL="redis://localhost:6379"
# Demo mode is safe for development without API credentials.
DATA_MODE=demo
# live mode: uses anonymous OpenSky API; rate limits/availability vary.
# DATA_MODE=live
OPENSKY_BASE_URL=https://opensky-network.org/api
# Optional OAuth2 client credentials for live mode:
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Geographic bounding box: India north-central region
BBOX_LAMIN=25
BBOX_LOMIN=75
BBOX_LAMAX=31
BBOX_LOMAX=83
POLL_MINUTES=2
CACHE_TTL_SECONDS=180
